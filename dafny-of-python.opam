opam-version: "2.0"
synopsis: "Translate a typed Python subset to Dafny"
description: "dafny-of-python translates a documented subset of typed Python into Dafny."
maintainer: "dafny-of-python contributors"
authors: ["dafny-of-python contributors"]
license: "MIT"
depends: [
  "ocaml" {>= "4.14.0" & < "5.0.0"}
  "dune" {>= "2.9"}
  "base"
  "core"
  "stdio"
  "sexplib"
  "ppx_jane"
  "menhir"
  "re2"
  "alcotest" {with-test}
  "bisect_ppx" {with-test & = "2.8.3"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://github.com/arsalanc-v2/dafny-of-python.git"
